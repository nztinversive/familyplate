{
  "name": "familyplate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@familyplate/web",
    "build": "npm run build --workspace=@familyplate/web",
    "start": "npm run start --workspace=@familyplate/web",
    "lint": "npm run lint --workspace=@familyplate/web",
    "familyplate": "npm exec --workspace=@familyplate/cli familyplate --",
    "agent:smoke": "node scripts/agent-smoke.mjs",
    "agent:pack": "npm pack --workspace=@familyplate/agent-tools --dry-run && npm pack --workspace=@familyplate/cli --dry-run",
    "agent:publish": "npm publish --workspace=@familyplate/agent-tools --access public && npm publish --workspace=@familyplate/cli --access public",
    "validate:google-play-launch": "node scripts/validate-google-play-launch.mjs",
    "test:mobile-dependencies": "node --test scripts/mobile-dependency-health.test.mjs",
    "store-preview:dev": "npm run dev --workspace=@familyplate/store-preview",
    "store-preview:render": "npm run render --workspace=@familyplate/store-preview",
    "store-preview:poster": "npm run poster --workspace=@familyplate/store-preview",
    "store-preview:still": "npm run still --workspace=@familyplate/store-preview",
    "convex:dev": "convex dev --typecheck=enable",
    "convex:deploy": "convex deploy"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.81.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "convex": "1.44.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.1.7",
    "react-native-worklets": "0.5.1",
    "typescript": "5.9.3"
  }
}
